<Shell
    x:Class="ProjetoAPP.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ProjetoAPP"
    FlyoutBehavior="Flyout"
    FlyoutWidth="280">

    <Shell.FlyoutHeader>
        <VerticalStackLayout
            Padding="20"
            HeightRequest="120"
            HorizontalOptions="Fill">

            <Label
                Text="Sistema Acadêmico"
                FontSize="22"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Menu Principal"
                FontSize="14"
                HorizontalOptions="Center"
                Margin="0,5,0,0" />

        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Início">

        <ShellContent
            Title="Início"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

    </FlyoutItem>

    <FlyoutItem Title="Períodos">

        <ShellContent
            Title="Períodos"
            ContentTemplate="{DataTemplate local:PeriodosPage}"
            Route="PeriodosPage" />

    </FlyoutItem>

    <FlyoutItem Title="Cursos">

        <ShellContent
            Title="Cursos"
            ContentTemplate="{DataTemplate local:CursosPage}"
            Route="CursosPage" />

    </FlyoutItem>

    <FlyoutItem Title="Disciplinas">

        <ShellContent
            Title="Disciplinas"
            ContentTemplate="{DataTemplate local:DisciplinasPage}"
            Route="DisciplinasPage" />

    </FlyoutItem>

</Shell>